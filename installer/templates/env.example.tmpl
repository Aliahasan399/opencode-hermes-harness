# OpenCode Harness — environment variable TEMPLATE (placeholders only).
# Copy this file to .env and fill values locally. NEVER commit the real .env.
# All variable NAMES below match the deployment .env; NO real values are included here.
# The installer reads only variable names (via regex), never values.

# --- Autonomy / optimization ------------------------------------------------
# LEVEL 1 (OBSERVE) default. Keep 1 unless you understand the controlled-execution gates.
OPTIMIZATION_LEVEL=1
# Minimum samples before an experiment/strategy comparison is considered.
EXPERIMENT_MIN_SAMPLES=

# --- Optional semantic LLM (disabled by default) ----------------------------
# Keep 0 by default: the engine is deterministic and does not require a paid API.
HARNESS_SEMANTIC_LLM=0
# Local OpenCode binary override, useful when process.execPath is opencode.exe.
HARNESS_OPENCODE_BIN=
# Context injection budget (characters) used by the prompt hook.
HARNESS_CONTEXT_BUDGET=
# Turn-end debounce window (milliseconds).
HARNESS_END_COALESCE_MS=

# --- Optional secure inference adapter (transport only) ---------------------
# Keep disabled until llm_test passes with your own credentials.
HARNESS_LLM_ENABLED=0
HARNESS_LLM_MODEL=
HARNESS_LLM_TRANSPORT=
HARNESS_LLM_TIMEOUT_MS=
HARNESS_LLM_MAX_RETRIES=
# IMPORTANT: API keys are NOT stored here. The adapter reads the key name from the
# protected environment variable HARNESS_LLM_KEY_ENV (operator-managed, not a .env key).

# --- PostgreSQL (docker-compose.yml maps these directly) --------------------
MEMORY_DB_USER=
MEMORY_DB_PASSWORD=<set-locally-never-commit>
MEMORY_DB_NAME=
MEMORY_DB_PORT=
# Local Ollama embedding service (optional but standard).
MEMORY_EMBED_MODEL=
MEMORY_EMBED_DIMS=
MEMORY_EMBED_PORT=

# --- Retrieval / classification ---------------------------------------------
MEMORY_RETRIEVAL_LIMIT=
MEMORY_CLASSIFY_MODEL=
MEMORY_CONFIDENCE_THRESHOLD=

# --- Dashboard --------------------------------------------------------------
MEMORY_DASHBOARD_PORT=

# Remember: this is a TEMPLATE. The real .env contains secrets, is ignored by Git,
# and is never read, copied, printed or published by the installer or diagnostics.
