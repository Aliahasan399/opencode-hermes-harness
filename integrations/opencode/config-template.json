{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "opencode-memory": {
        "type": "local",
        "command": ["node", "<ABSOLUTE_PATH_TO_ENGINE>/src/server.js"],
        "cwd": "<ABSOLUTE_PATH_TO_ENGINE>",
        "environment": {
          "MEMORY_DB_HOST": "{env:MEMORY_DB_HOST}",
          "MEMORY_DB_PORT": "{env:MEMORY_DB_PORT}",
          "MEMORY_DB_USER": "{env:MEMORY_DB_USER}",
          "MEMORY_DB_PASSWORD": "{env:MEMORY_DB_PASSWORD}",
          "MEMORY_DB_NAME": "{env:MEMORY_DB_NAME}"
        },
        "codemode": false,
        "disabled": false
      }
    }
  }
}
